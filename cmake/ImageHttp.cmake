# HTTP/TLS belongs only to installation, not the client library or runtime.
include_guard(GLOBAL)
include(${CMAKE_CURRENT_LIST_DIR}/../digest-dependencies.cmake)
function(shroot_image_http_dependencies)
    FetchContent_GetProperties(guest_digest)
    set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
    set(CMAKE_POLICY_DEFAULT_CMP0126 NEW)
    set(ENABLE_PROGRAMS OFF)
    set(ENABLE_TESTING OFF)
    set(MBEDTLS_FATAL_WARNINGS OFF)
    set(DISABLE_PACKAGE_CONFIG_AND_INSTALL ON)
    set(USE_SHARED_MBEDTLS_LIBRARY OFF)
    set(USE_STATIC_MBEDTLS_LIBRARY ON)
    set(MBEDTLS_CONFIG_FILE "")
    set(MBEDTLS_USER_CONFIG_FILE "")
    add_subdirectory("${guest_digest_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/tls" EXCLUDE_FROM_ALL)
    set(MBEDTLS_INCLUDE_DIR "${guest_digest_SOURCE_DIR}/include")
    set(MBEDTLS_LIBRARY mbedtls)
    set(MBEDX509_LIBRARY mbedx509)
    set(MBEDCRYPTO_LIBRARY mbedcrypto)
    set(MBEDTLS_USE_STATIC_LIBS ON)
    # Full 3.6.7 configuration; this probe cannot link an unbuilt source target.
    set(HAVE_MBEDTLS_DES_CRYPT_ECB 1)

    set(BUILD_SHARED_LIBS OFF)
    set(BUILD_STATIC_LIBS ON)
    set(BUILD_TESTING OFF)
    set(BUILD_EXAMPLES OFF)
    set(BUILD_CURL_EXE OFF)
    set(BUILD_LIBCURL_DOCS OFF)
    set(BUILD_MISC_DOCS OFF)
    set(ENABLE_CURL_MANUAL OFF)
    set(CURL_DISABLE_INSTALL ON)
    set(CURL_ENABLE_EXPORT_TARGET OFF)
    set(PICKY_COMPILER OFF)
    set(CURL_USE_MBEDTLS ON)
    foreach(feature OPENSSL WOLFSSL GNUTLS RUSTLS LIBPSL LIBSSH LIBSSH2 GSASL GSSAPI
            LIBBACKTRACE LIBUV PKGCONFIG CMAKECONFIG)
        set(CURL_USE_${feature} OFF)
    endforeach()
    foreach(feature NGHTTP2 NGTCP2 QUICHE LIBIDN2 HTTPSRR ECH)
        set(USE_${feature} OFF)
    endforeach()
    foreach(feature ZLIB BROTLI ZSTD)
        set(CURL_${feature} OFF)
    endforeach()
    foreach(feature ALTSVC COOKIES DICT DOH FILE FTP GOPHER HSTS IMAP IPFS LDAP LDAPS
            MIME MQTT NETRC POP3 RTSP SMTP TELNET TFTP WEBSOCKETS)
        set(CURL_DISABLE_${feature} ON)
    endforeach()
    # Select the host's trust store at runtime, never the build machine's paths.
    set(CURL_CA_BUNDLE none CACHE STRING "Trust is selected by the image worker" FORCE)
    set(CURL_CA_PATH none CACHE STRING "Trust is selected by the image worker" FORCE)
    set(CURL_CA_BUNDLE_SET FALSE)
    set(CURL_CA_PATH_SET FALSE)
    FetchContent_Declare(shroot_curl
        URL https://curl.se/download/curl-8.23.0.tar.xz
        URL_HASH SHA256=8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5
        DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    FetchContent_MakeAvailable(shroot_curl)
    configure_file(${shroot_curl_SOURCE_DIR}/COPYING ${shroot_license_directory}/curl.txt COPYONLY)
endfunction()
shroot_image_http_dependencies()
