include_guard(GLOBAL)
if(SHROOT_BUILD_RUNTIME)
    set(metadata "{}")
    string(JSON metadata SET "${metadata}" format 1)
    foreach(field version system architecture)
        if(field STREQUAL version)
            set(value "${SHROOT_VERSION}")
        elseif(field STREQUAL system)
            set(value "${CMAKE_SYSTEM_NAME}")
        else()
            set(value "${CMAKE_SYSTEM_PROCESSOR}")
        endif()
        string(JSON metadata SET "${metadata}" ${field} "\"${value}\"")
    endforeach()
    string(JSON metadata SET "${metadata}" minimumKernel "\"5.15\"")
    string(JSON metadata SET "${metadata}" helpers "{}")
    foreach(helper image run supervisor bootstrap service)
        string(JSON metadata SET "${metadata}" helpers ${helper} "\"$<TARGET_FILE_NAME:${helper}>\"")
    endforeach()
    if(SHROOT_BUILD_TESTS)
        set(fixture_value true)
    else()
        set(fixture_value false)
    endif()
    string(JSON metadata SET "${metadata}" testHooks "${fixture_value}")
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/runtime.json" CONTENT "${metadata}\n")
    install(FILES "${CMAKE_CURRENT_BINARY_DIR}/runtime.json" DESTINATION libexec/shroot COMPONENT Shroot)
endif()

set(CPACK_GENERATOR TGZ CACHE STRING "CPack generators for the native bundle")
if(SHROOT_TERMUX_PACKAGE AND (NOT ANDROID OR NOT SHROOT_BUILD_RUNTIME OR SHROOT_BUILD_TESTS))
    message(FATAL_ERROR "The Termux package needs a production Android ARM64 runtime build")
endif()
set(CPACK_PACKAGE_NAME shroot)
set(CPACK_PACKAGE_VERSION "${SHROOT_VERSION}")
if(CPACK_GENERATOR STREQUAL "DEB")
    string(REPLACE "-" "~" CPACK_DEBIAN_PACKAGE_VERSION "${SHROOT_VERSION}")
endif()
string(TOLOWER "${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}" bundle_platform)
set(CPACK_PACKAGE_FILE_NAME "shroot-${SHROOT_VERSION}-${bundle_platform}")
if(SHROOT_TERMUX_PACKAGE)
    set(CPACK_PACKAGE_FILE_NAME "shroot-termux-aarch64")
endif()
if(NOT SHROOT_BUILD_RUNTIME)
    string(APPEND CPACK_PACKAGE_FILE_NAME "-client")
endif()
set(CPACK_PACKAGE_CHECKSUM SHA256)
set(CPACK_INSTALL_CMAKE_PROJECTS "${PROJECT_BINARY_DIR};${PROJECT_NAME};Shroot;/")
set(CPACK_STRIP_FILES TRUE)
include(CPack)
